# ==========================================
# Transcription + traduction des sous-titres Jitsi
# ==========================================
# Variables à AJOUTER dans jitsi.env (partagé par prosody, jicofo, jitsi-web
# et le transcriber), puis : docker compose up -d --force-recreate prosody jicofo jitsi-web transcriber

# Active la transcription côté prosody (domaine caché), jicofo (brewery Jigasi)
# et jitsi-web (config.transcription.enabled + bouton sous-titres)
ENABLE_TRANSCRIPTIONS=1

# Compte XMPP du transcriber sur hidden.meet.jitsi : prosody le crée avec ce
# mot de passe et Jigasi s'y connecte avec. Générer avec : openssl rand -hex 16
JIGASI_TRANSCRIBER_PASSWORD=

# Langues de traduction proposées dans Jitsi — doit matcher LT_LOAD_ONLY
# du service LibreTranslate (docker-compose.yml)
TRANSLATION_LANGUAGES=['en','fr','ar','it','es','de','tr']
TRANSLATION_LANGUAGES_HEAD=['fr','en']

# ==========================================
# Google Cloud Speech-to-Text — variables à AJOUTER dans jigasi.env
# ==========================================
# 1. Dans la console Google Cloud : activer l'API "Cloud Speech-to-Text",
#    créer un compte de service et télécharger sa clé JSON.
# 2. Recopier ici les champs de cette clé JSON. Le conteneur reconstruit
#    /run/jigasi/config/key.json à partir de ces 6 variables (toutes obligatoires).
GC_PROJECT_ID=
GC_PRIVATE_KEY_ID=
# Garder les guillemets doubles et les \n tels qu'ils apparaissent dans le JSON
GC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GC_CLIENT_EMAIL=
GC_CLIENT_ID=
GC_CLIENT_CERT_URL=
